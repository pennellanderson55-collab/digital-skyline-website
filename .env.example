# Supabase — Settings → API in your project dashboard
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Stripe — Client Portal payment page (/client-portal).
# Simplest option: paste a Stripe Payment Link URL here and the
# "Proceed to Secure Payment" button will forward the client to it.
# For invoice-specific amounts, swap to a Checkout Session created by a
# serverless endpoint (see src/pages/ClientPortal.jsx for details).
VITE_STRIPE_PAYMENT_LINK=
