# Supabase — Settings → API in your project dashboard
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Supabase service role — SERVER-SIDE ONLY for the /api/book consultation
# endpoint. It bypasses RLS to read a prospect and write the booking for an
# unauthenticated email visitor. Do NOT prefix with VITE_ (that would expose it
# in the browser bundle). Add in Vercel → Project → Settings → Environment
# Variables. Without it, /api/book returns "Booking is not configured".
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — Client Portal payment page (/client-portal).
# Simplest option: paste a Stripe Payment Link URL here and the
# "Proceed to Secure Payment" button will forward the client to it.
# For invoice-specific amounts, swap to a Checkout Session created by a
# serverless endpoint (see src/pages/ClientPortal.jsx for details).
VITE_STRIPE_PAYMENT_LINK=

# Stripe automatic sync — SERVER-SIDE ONLY for /api/stripe-webhook. Do NOT
# prefix with VITE_ (that would expose them in the browser bundle). Add both in
# Vercel → Project → Settings → Environment Variables.
#   STRIPE_SECRET_KEY      — Stripe Dashboard → Developers → API keys (sk_live_… / sk_test_…)
#   STRIPE_WEBHOOK_SECRET  — the signing secret (whsec_…) shown when you create
#                            the webhook endpoint in Stripe (Developers → Webhooks).
# The webhook also uses SUPABASE_SERVICE_ROLE_KEY (already listed above).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (Resend) — SERVER-SIDE ONLY for the /api/send-email Vercel function.
# Do NOT prefix these with VITE_ (that would expose them in the browser bundle).
# 1. Verify the digitalskylineco.com domain in Resend.
# 2. Add RESEND_API_KEY in Vercel → Project → Settings → Environment Variables.
# Addresses below are optional overrides; sensible role-based defaults are built in.
RESEND_API_KEY=
EMAIL_FROM=Digital Skyline Co. <hello@digitalskylineco.com>
EMAIL_NOTIFY=hello@digitalskylineco.com
EMAIL_SUPPORT=support@digitalskylineco.com

# ── Website Previews (branded /preview/<token> pages) ────────────────────────
# The preview system reuses SUPABASE_SERVICE_ROLE_KEY + RESEND_API_KEY (above).
# Run supabase/previews.sql (preview_links + preview_views) AND
# supabase/comms_storage.sql (comms-media bucket) once. Assets stream through
# /api/preview-asset so the client never sees the Supabase URL.
#   SITE_URL — canonical site origin used to build preview links + notify links
#              (defaults to https://digitalskylineco.com).
SITE_URL=
#   DSC_PHONE — optional; shown in the preview page footer only when set.
DSC_PHONE=

# ── Communications Center ────────────────────────────────────────────────────
# The Communications hub is PROVIDER-AGNOSTIC. Outbound send uses whichever
# provider is configured (Resend is primary, from hello@digitalskylineco.com);
# the AI assistant uses ANTHROPIC_API_KEY; Sent/Drafts/Scheduled persistence uses
# SUPABASE_SERVICE_ROLE_KEY (all already listed above). Run supabase/comms.sql
# once to create the comms_messages table.
#
# Optional model override for the Communications assistant (defaults to ANTHROPIC_MODEL / claude-opus-4-8):
COMMS_MODEL=
#
# OPTIONAL — Gmail as the inbox / reply / sync provider (Resend still sends).
# Headless server-side OAuth via a long-lived refresh token for the business
# mailbox. Without these, the inbox shows its empty/demo state and Resend keeps
# sending — nothing breaks. Do NOT prefix with VITE_.
#   1. Create an OAuth client (Desktop) in Google Cloud → APIs & Services.
#   2. Grant the Gmail API scope and mint a refresh token (one-time consent).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=
#
# OPTIONAL — route every live send to a test inbox while validating.
# EMAIL_SANDBOX_MODE=true reroutes all Communications sends to EMAIL_SANDBOX_TO.
EMAIL_SANDBOX_MODE=
EMAIL_SANDBOX_TO=

# AI Website Intelligence (Sprint 2) — SERVER-SIDE ONLY for /api/analyze-website.
# Do NOT prefix with VITE_. Without it, audits still run (signals + scores);
# only the AI sales brief is skipped.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-4-8).
ANTHROPIC_MODEL=
# Optional — enables real Lighthouse performance scoring via Google PageSpeed.
# Without it, performance uses a homepage heuristic.
PAGESPEED_API_KEY=
